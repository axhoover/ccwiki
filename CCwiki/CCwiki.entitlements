<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  CCwiki is deliberately NOT sandboxed.

	  The app's whole job is to drive developer tooling that lives outside any
	  container: it execs `git` against a clone in Application Support, and
	  execs `claude` and `gh` inside git worktrees to run ingestion jobs.
	  A sandboxed process cannot spawn arbitrary helper executables, so the
	  sandbox is off and the app ships outside the Mac App Store.

	  The hardened-runtime exceptions below are what a Developer ID and
	  notarized build needs once `make dist` turns the hardened runtime on.
	  They are no-ops for the ad-hoc `make run` build.

	  (Keep double hyphens out of these comments. AMFI parses this file with a
	  strict XML parser that rejects them, and the failure surfaces as an
	  unhelpful "syntax error near line N" during codesign.)
	-->

	<!-- Spawn git, gh and claude, which are not signed by us. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- `claude` is a Node program; its JIT needs writable, executable pages. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
